{
  "name": "@casys/mcp-calculix",
  "version": "0.2.1",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@casys/mcp-server"]
  },
  "tasks": {
    "serve": "deno run --allow-all server.ts --port=3015",
    "build:ui": "deno run -A src/ui/results-viewer/build.ts",
    "check": "deno check mod.ts server.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check deno.json mod.ts server.ts src/api src/client.ts src/results.ts src/tools src/ui/results-viewer/build.ts src/ui/results-viewer/src tests",
    "release:check": "deno task fmt && deno task check && deno task lint && deno task test",
    "compile": "deno compile -A --output mcp-calculix server.ts",
    "test": "deno test --allow-all tests/ && deno test --config src/ui/results-viewer/deno.json --allow-all src/ui/results-viewer/src/model_test.ts"
  },
  "exports": {
    ".": "./mod.ts",
    "./server": "./server.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "server.ts",
      "src/**/*.ts",
      "src/ui/dist/**/*.html",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "**/*_test.ts",
      "**/*.test.ts",
      "**/*.bench.ts"
    ]
  },
  "imports": {
    "@casys/mcp-server": "jsr:@casys/mcp-server@0.24.1",
    "ajv": "npm:ajv@^8.17.1",
    "hono": "npm:hono@^4",
    "hono/cors": "npm:hono@^4/cors",
    "jose": "npm:jose@^6.0.0",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.0",
    "@std/yaml": "jsr:@std/yaml@^1",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1.1.0"
  }
}
