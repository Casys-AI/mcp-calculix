{
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@casys/mcp-view"]
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "deno.ns",
      "deno.window",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext"
    ]
  },
  "imports": {
    "@casys/mcp-view": "jsr:@casys/mcp-view@0.7.0",
    "@casys/mcp-view/preact": "jsr:@casys/mcp-view@0.7.0/preact",
    "linkedom": "npm:linkedom@0.18.12",
    "preact": "npm:preact@^10.28.3",
    "preact/jsx-runtime": "npm:preact@^10.28.3/jsx-runtime",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.1.0"
  },
  "tasks": {
    "build": "deno run -A build.ts",
    "check": "deno check src/main.ts",
    "test": "deno test --allow-read src",
    "fmt": "deno fmt --check index.html build.ts src"
  }
}
