{
  "lock": false,
  "minimumDependencyAge": {
    "age": "P1D"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "deno.ns",
      "deno.window",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext"
    ]
  },
  "imports": {
    "linkedom": "npm:linkedom@0.18.12",
    "preact": "npm:preact@^10.28.3",
    "preact/jsx-runtime": "npm:preact@^10.28.3/jsx-runtime",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.1.0"
  },
  "tasks": {
    "build": "deno run -A build.ts",
    "test": "deno run -A test.ts",
    "check:bundle": "deno run -A check-bundle.ts",
    "fmt": "deno fmt --check index.html build.ts check-bundle.ts local-modules.ts test.ts src"
  }
}
